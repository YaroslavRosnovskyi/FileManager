{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "StoragePaths": {
    "Base": "/app/Storage"
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://+:8080",
        "Protocols": "Http2"
      },
      "Https": {
        "Url": "https://+:8081",
        "Protocols": "Http2",
        "Certificate": {
          "Path": "/app/https/aspnetapp.pfx",
          "Password": "MySecretPassword123"
        }
      }
    }
  }
}