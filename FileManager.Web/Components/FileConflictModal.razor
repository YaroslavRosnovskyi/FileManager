@using FileManager.Core.Models
@using FileManager.Web.Services

@if (Show)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="bi bi-exclamation-triangle text-warning me-2"></i>
                        File Conflict Detected
                    </h5>
                    <button type="button" class="btn-close" @onclick="HandleCancel"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-warning">
                        <strong>A file with the same name already exists!</strong>
                    </div>
                    
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <h6><i class="bi bi-upload me-2"></i>New File</h6>
                            <div class="card">
                                <div class="card-body">
                                    <p class="card-text">
                                        <strong>Name:</strong> @FileName<br/>
                                        <strong>Size:</strong> @FileUtils.FormatFileSize(FileSize)
                                    </p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <h6><i class="bi bi-cloud me-2"></i>Existing File(s)</h6>
                            @if (ConflictingFiles.Any())
                            {
                                @foreach (var file in ConflictingFiles)
                                {
                                    <div class="card mb-2">
                                        <div class="card-body">
                                            <p class="card-text">
                                                <strong>Name:</strong> @file.Name<br/>
                                                <strong>Size:</strong> @FileUtils.FormatFileSize(file.Size)<br/>
                                                <strong>Modified:</strong> @file.ModifiedAt.ToString("yyyy-MM-dd HH:mm:ss")<br/>
                                                <strong>Modified By:</strong> @file.ModifiedBy
                                            </p>
                                            @if (ConflictingFiles.Count == 1)
                                            {
                                                <div class="form-check">
                                                    <input class="form-check-input" type="radio" name="overwriteOption" 
                                                           id="overwrite_@file.Id" value="@file.Id" 
                                                           @onchange="@((e) => SelectedOverwriteFileId = e.Value?.ToString())" />
                                                    <label class="form-check-label" for="overwrite_@file.Id">
                                                        Replace this file
                                                    </label>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }
                            }
                        </div>
                    </div>
                    
                    @if (ConflictingFiles.Count > 1)
                    {
                        <div class="mb-3">
                            <h6>Choose which file to replace:</h6>
                            @foreach (var file in ConflictingFiles)
                            {
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="overwriteOption" 
                                           id="overwrite_@file.Id" value="@file.Id" 
                                           @onchange="@((e) => SelectedOverwriteFileId = e.Value?.ToString())" />
                                    <label class="form-check-label" for="overwrite_@file.Id">
                                        @file.Name (@FileUtils.FormatFileSize(file.Size), modified @file.ModifiedAt.ToString("yyyy-MM-dd HH:mm:ss"))
                                    </label>
                                </div>
                            }
                        </div>
                    }
                    
                    <div class="form-check mb-3">
                        <input class="form-check-input" type="radio" name="overwriteOption" 
                               id="keepBoth" value="keepboth" 
                               @onchange="@((e) => SelectedOverwriteFileId = e.Value?.ToString())" />
                        <label class="form-check-label" for="keepBoth">
                            Keep both files (rename new file)
                        </label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="HandleCancel">
                        <i class="bi bi-x me-2"></i>Cancel
                    </button>
                    <button type="button" class="btn btn-warning" @onclick="HandleOverwrite" 
                            disabled="@(string.IsNullOrEmpty(SelectedOverwriteFileId))">
                        <i class="bi bi-check me-2"></i>Proceed
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool Show { get; set; }
    [Parameter] public string FileName { get; set; } = string.Empty;
    [Parameter] public long FileSize { get; set; }
    [Parameter] public List<FileItem> ConflictingFiles { get; set; } = new();
    [Parameter] public EventCallback<FileConflictResult> OnResult { get; set; }

    private string? SelectedOverwriteFileId;

    protected override void OnParametersSet()
    {
        if (Show)
        {
            SelectedOverwriteFileId = null;
        }
    }

    private async Task HandleOverwrite()
    {
        if (string.IsNullOrEmpty(SelectedOverwriteFileId))
            return;

        var result = new FileConflictResult
        {
            Action = SelectedOverwriteFileId == "keepboth" ? ConflictAction.KeepBoth : ConflictAction.Overwrite,
            OverwriteFileId = SelectedOverwriteFileId == "keepboth" ? null : SelectedOverwriteFileId
        };

        await OnResult.InvokeAsync(result);
    }

    private async Task HandleCancel()
    {
        var result = new FileConflictResult
        {
            Action = ConflictAction.Cancel
        };

        await OnResult.InvokeAsync(result);
    }

    public class FileConflictResult
    {
        public ConflictAction Action { get; set; }
        public string? OverwriteFileId { get; set; }
    }

    public enum ConflictAction
    {
        Cancel,
        Overwrite,
        KeepBoth
    }
}